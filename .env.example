RESEND_API_KEY=
CONTACT_EMAIL=

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Required on the server (Vercel) so the blog can read published Sanity posts
SANITY_API_TOKEN=

# Editor token, required only to run the blog seed script (npm run blog:seed)
SANITY_WRITE_TOKEN=

# Protects POST /api/generate-post and POST /api/translate-post.
# The Studio also sends the logged-in editor's Sanity token.
# Set both values to the same secret if the Studio login does not expose a token.
STUDIO_ACTION_SECRET=
NEXT_PUBLIC_STUDIO_ACTION_SECRET=
